# Database
DATABASE_URL="postgresql://username:password@localhost:5432"
DATABASE_URL_TEST="postgresql://username:password@localhost:5432/test"

# JWT
JWT_SECRET="your-jwt-secret-key"
JWT_EXPIRES_IN="7d"

# Redis
REDIS_URL="redis://localhost:6379"
REDIS_URL_WORKER="redis://localhost:6379"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3107/auth/google/callback"

# Frontend URL (for redirect after Google OAuth)
FRONTEND_URL="http://localhost:3000"

# Email Configuration
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-app-password"

# Cloudinary
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# AWS S3
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
AWS_REGION="ap-southeast-1"
AWS_S3_BUCKET_NAME="your-s3-bucket-name"

# RabbitMQ
RABBITMQ_URL="amqp://guest:guest@localhost:5672/"
RABBITMQ_QUEUE="name-of-your-queue"

# Server
PORT=3107
