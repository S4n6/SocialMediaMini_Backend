generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String               @id @default(uuid()) @map("UserId")
  fullName                String               @map("FullName")
  email                   String               @unique @map("Email")
  googleId                String?              @unique @map("GoogleId")
  dateOfBirth             DateTime?            @map("DateOfBirth")
  phoneNumber             String?              @map("PhoneNumber")
  avatar                  String?              @map("Avatar")
  bio                     String?              @map("Bio")
  location                String?              @map("Location")
  gender                  String?              @map("Gender")
  isEmailVerified         Boolean              @default(false) @map("IsEmailVerified")
  emailVerifiedAt         DateTime?            @map("EmailVerifiedAt")
  createdAt               DateTime             @default(now()) @map("CreatedAt")
  updatedAt               DateTime             @updatedAt @map("UpdatedAt")
  websiteUrl              String?              @map("WebsiteUrl")
  lastProfileUpdate       DateTime?            @map("LastProfileUpdate")
  passwordHash            String?              @map("PasswordHash")
  status                  UserStatus           @default(ACTIVE) @map("Status")
  username                String               @unique @map("Username")
  role                    UserRole             @default(USER) @map("Role")
  lastVerificationSentAt  DateTime?            @map("LastVerificationSentAt")
  lastPasswordResetSentAt DateTime?            @map("LastPasswordResetSentAt")
  comments                Comment[]
  following               Follow[]             @relation("UserFollowing")
  followers               Follow[]             @relation("UserFollowers")
  sentMessages            Message[]
  notifications           Notification[]
  posts                   Post[]
  reactions               Reaction[]
  reportsSubmitted        Report[]             @relation("ReportSubmitter")
  reportsReceived         Report[]             @relation("ReportTarget")
  searchHistory           SearchHistory?       @relation("UserSearchHistory")
  searchedHistory         SearchHistoryEntry[] @relation("UserSearchedHistory")
  sessions                Session[]
  stories                 Story[]
  storyViews              StoryView[]          @relation("UserStoryViews")
  conversations           UserConversation[]
  savedPosts              SavedPost[]
  blocking                Block[]              @relation("UserBlocking")
  blockedBy               Block[]              @relation("UserBlockedBy")
  taggedInPosts           PostUserTag[]
  closeFriends            CloseFriend[]        @relation("UserCloseFriends")
  closeFriendOf           CloseFriend[]        @relation("CloseFriendOf")

  @@map("Users")
}

model Post {
  id             String        @id @default(uuid()) @map("PostId")
  content        String?       @map("Content")
  privacy        PostPrivacy   @default(PUBLIC) @map("Privacy")
  status         PostStatus    @default(PUBLISHED) @map("Status")
  createdAt      DateTime      @default(now()) @map("CreatedAt")
  updatedAt      DateTime      @updatedAt @map("UpdatedAt")
  authorId       String        @map("AuthorId")
  locationName   String?       @map("LocationName")
  latitude       Float?        @map("Latitude")
  longitude      Float?        @map("Longitude")
  originalPostId String?       @map("OriginalPostId")
  comments       Comment[]
  hashtags       PostHashtag[]
  postMedia      PostMedia[]
  author         User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reactions      Reaction[]
  reports        Report[]
  savedBy        SavedPost[]
  taggedUsers    PostUserTag[]
  originalPost   Post?         @relation("SharedPosts", fields: [originalPostId], references: [id], onDelete: SetNull)
  sharedPosts    Post[]        @relation("SharedPosts")

  @@index([authorId])
  @@map("Posts")
}

model Reaction {
  id        String       @id @default(uuid()) @map("ReactionId")
  type      ReactionType @map("Type")
  createdAt DateTime     @default(now()) @map("CreatedAt")
  reactorId String       @map("ReactorId")
  postId    String?      @map("PostId")
  commentId String?      @map("CommentId")
  comment   Comment?     @relation(fields: [commentId], references: [id], onDelete: Cascade)
  post      Post?        @relation(fields: [postId], references: [id], onDelete: Cascade)
  reactor   User         @relation(fields: [reactorId], references: [id], onDelete: Cascade)

  @@unique([reactorId, postId])
  @@unique([reactorId, commentId])
  @@index([postId])
  @@index([commentId])
  @@map("Reactions")
}

model Comment {
  id        String     @id @default(uuid()) @map("CommentId")
  content   String     @map("Content")
  createdAt DateTime   @default(now()) @map("CreatedAt")
  updatedAt DateTime   @updatedAt @map("UpdatedAt")
  authorId  String     @map("AuthorId")
  postId    String     @map("PostId")
  parentId  String?    @map("ParentId")
  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent    Comment?   @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]  @relation("CommentReplies")
  post      Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  reactions Reaction[]

  @@index([postId])
  @@index([authorId])
  @@index([parentId])
  @@map("Comments")
}

model Follow {
  id          String   @id @default(uuid()) @map("FollowId")
  createdAt   DateTime @default(now()) @map("CreatedAt")
  followerId  String   @map("FollowerId")
  followingId String   @map("FollowingId")
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("Follows")
}

model Conversation {
  id           String             @id @default(uuid()) @map("ConversationId")
  name         String?            @map("Name")
  isGroup      Boolean            @default(false) @map("IsGroup")
  createdAt    DateTime           @default(now()) @map("CreatedAt")
  updatedAt    DateTime           @updatedAt @map("UpdatedAt")
  messages     Message[]
  participants UserConversation[]

  @@map("Conversations")
}

model Message {
  id             String        @id @default(uuid()) @map("MessageId")
  content        String        @map("Content")
  messageType    MessageType   @default(TEXT) @map("MessageType")
  status         MessageStatus @default(SENT) @map("Status")
  isRead         Boolean       @default(false) @map("IsRead")
  createdAt      DateTime      @default(now()) @map("CreatedAt")
  editedAt       DateTime?     @map("EditedAt")
  deletedAt      DateTime?     @map("DeletedAt")
  senderId       String        @map("SenderId")
  conversationId String        @map("ConversationId")
  replyToId      String?       @map("ReplyToId")
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User          @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo        Message?      @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        Message[]     @relation("MessageReplies")
  readReceipts   MessageReadReceipt[]

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([senderId])
  @@index([replyToId])
  @@map("Messages")
}

model MessageReadReceipt {
  id        String   @id @default(uuid()) @map("MessageReadReceiptId")
  messageId String   @map("MessageId")
  userId    String   @map("UserId")
  readAt    DateTime @default(now()) @map("ReadAt")
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, messageId])
  @@map("MessageReadReceipts")
}

model UserConversation {
  id             String           @id @default(uuid()) @map("UserConversationId")
  role           ConversationRole @default(MEMBER) @map("Role")
  joinedAt       DateTime         @default(now()) @map("JoinedAt")
  lastReadAt     DateTime?        @map("LastReadAt")
  userId         String           @map("UserId")
  conversationId String           @map("ConversationId")
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, conversationId])
  @@map("UserConversations")
}

model Story {
  id        String     @id @default(uuid()) @map("StoryId")
  content   String?    @map("Content")
  mediaUrl  String?    @map("MediaUrl")
  mediaType MediaType? @map("MediaType")
  expiresAt DateTime   @map("ExpiresAt")
  createdAt DateTime   @default(now()) @map("CreatedAt")
  authorId  String     @map("AuthorId")
  isActive  Boolean    @default(true) @map("IsActive")
  updatedAt DateTime   @updatedAt @map("UpdatedAt")
  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  views     StoryView[]

  @@index([authorId])
  @@index([expiresAt])
  @@map("Stories")
}

model StoryView {
  id       String   @id @default(uuid()) @map("StoryViewId")
  viewedAt DateTime @default(now()) @map("ViewedAt")
  storyId  String   @map("StoryId")
  viewerId String   @map("ViewerId")
  story    Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewer   User     @relation("UserStoryViews", fields: [viewerId], references: [id], onDelete: Cascade)

  @@unique([storyId, viewerId])
  @@map("StoryViews")
}

model Report {
  id           String       @id @default(uuid()) @map("ReportId")
  reason       String       @map("Reason")
  description  String?      @map("Description")
  status       ReportStatus @default(PENDING) @map("Status")
  createdAt    DateTime     @default(now()) @map("CreatedAt")
  resolvedAt   DateTime?    @map("ResolvedAt")
  reporterId   String       @map("ReporterId")
  targetUserId String?      @map("TargetUserId")
  targetPostId String?      @map("TargetPostId")
  reporter     User         @relation("ReportSubmitter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetPost   Post?        @relation(fields: [targetPostId], references: [id], onDelete: Cascade)
  targetUser   User?        @relation("ReportTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([reporterId])
  @@map("Reports")
}

model Notification {
  id         String              @id @default(uuid()) @map("NotificationId")
  type       String              @map("Type")
  title      String              @map("Title")
  content    String              @map("Content")
  isRead     Boolean             @default(false) @map("IsRead")
  createdAt  DateTime            @default(now()) @map("CreatedAt")
  userId     String              @map("UserId")
  entityId   String?             @map("EntityId")
  entityType NotificationEntity? @map("EntityType")
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@map("Notifications")
}

model Hashtag {
  id         String        @id @default(uuid()) @map("HashtagId")
  name       String        @unique @map("Name")
  usageCount Int           @default(0) @map("UsageCount")
  createdAt  DateTime      @default(now()) @map("CreatedAt")
  posts      PostHashtag[]

  @@map("Hashtags")
}

model PostHashtag {
  id        String  @id @default(uuid()) @map("PostHashtagId")
  postId    String  @map("PostId")
  hashtagId String  @map("HashtagId")
  hashtag   Hashtag @relation(fields: [hashtagId], references: [id], onDelete: Cascade)
  post      Post    @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, hashtagId])
  @@map("PostHashtags")
}

model PostMedia {
  id           String           @id @default(uuid()) @map("PostMediaId")
  url          String           @map("Url")
  type         MediaType        @map("Type")
  order        Int?             @map("Order")
  status       MediaStatus      @default(PENDING) @map("Status")
  processedUrl String?          @map("ProcessedUrl")
  thumbnailUrl String?          @map("ThumbnailUrl")
  s3Key        String?          @map("S3Key")
  errorMessage String?          @map("ErrorMessage")
  createdAt    DateTime         @default(now()) @map("CreatedAt")
  updatedAt    DateTime         @updatedAt @map("UpdatedAt")
  postId       String           @map("PostId")
  post         Post             @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("PostMedias")
}

model Session {
  id         String     @id @default(uuid()) @map("SessionId")
  sessionId  String     @unique @map("SessionIdentifier")
  expiresAt  DateTime   @map("ExpiresAt")
  createdAt  DateTime   @default(now()) @map("CreatedAt")
  lastUsedAt DateTime   @default(now()) @map("LastUsedAt")
  isRevoked  Boolean    @default(false) @map("IsRevoked")
  revokedAt  DateTime?  @map("RevokedAt")
  userAgent  String?    @map("UserAgent")
  ipAddress  String?    @map("IpAddress")
  userId     String     @map("UserId")
  clientType ClientType @default(WEB) @map("ClientType")
  deviceName String?    @map("DeviceName")
  deviceType String?    @map("DeviceType")
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([userId, sessionId])
  @@map("Sessions")
}

model SearchHistory {
  id        String               @id @default(uuid()) @map("SearchHistoryId")
  userId    String               @unique @map("UserId")
  createdAt DateTime             @default(now()) @map("CreatedAt")
  updatedAt DateTime             @updatedAt @map("UpdatedAt")
  user      User                 @relation("UserSearchHistory", fields: [userId], references: [id], onDelete: Cascade)
  entries   SearchHistoryEntry[]

  @@map("SearchHistories")
}

model SearchHistoryEntry {
  id              String        @id @default(uuid()) @map("SearchHistoryEntryId")
  searchedUserId  String        @map("SearchedUserId")
  searchedAt      DateTime      @default(now()) @map("SearchedAt")
  searchHistoryId String        @map("SearchHistoryId")
  searchHistory   SearchHistory @relation(fields: [searchHistoryId], references: [id], onDelete: Cascade)
  searchedUser    User          @relation("UserSearchedHistory", fields: [searchedUserId], references: [id], onDelete: Cascade)

  @@unique([searchHistoryId, searchedUserId])
  @@map("SearchHistoryEntries")
}

model SavedPost {
  id        String   @id @default(uuid()) @map("SavedPostId")
  userId    String   @map("UserId")
  postId    String   @map("PostId")
  savedAt   DateTime @default(now()) @map("SavedAt")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
  @@map("SavedPosts")
}

model Block {
  id        String   @id @default(uuid()) @map("BlockId")
  blockerId String   @map("BlockerId")
  blockedId String   @map("BlockedId")
  blockedAt DateTime @default(now()) @map("BlockedAt")
  blocker   User     @relation("UserBlocking", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("UserBlockedBy", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
  @@map("Blocks")
}

model PostUserTag {
  id        String   @id @default(uuid()) @map("PostUserTagId")
  postId    String   @map("PostId")
  userId    String   @map("UserId")
  xPosition Float?   @map("XPosition")
  yPosition Float?   @map("YPosition")
  createdAt DateTime @default(now()) @map("CreatedAt")
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
  @@map("PostUserTags")
}

model CloseFriend {
  id        String   @id @default(uuid()) @map("CloseFriendId")
  userId    String   @map("UserId")
  friendId  String   @map("FriendId")
  addedAt   DateTime @default(now()) @map("AddedAt")
  user      User     @relation("UserCloseFriends", fields: [userId], references: [id], onDelete: Cascade)
  friend    User     @relation("CloseFriendOf", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@index([userId])
  @@map("CloseFriends")
}

enum UserRole {
  USER
  ADMIN
  MODERATOR
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  BANNED
}

enum PostPrivacy {
  PUBLIC
  FOLLOWERS
  PRIVATE
  CLOSE_FRIENDS
}

enum PostStatus {
  PROCESSING
  PUBLISHED
  FAILED
}

enum ReactionType {
  LIKE
  LOVE
  LAUGH
  WOW
  SAD
  ANGRY
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  FILE
}

enum ConversationRole {
  MEMBER
  ADMIN
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  DELETED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum MediaStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  DISMISSED
}

enum ClientType {
  WEB
  MOBILE
  DESKTOP
}

enum NotificationEntity {
  POST
  COMMENT
  USER
  STORY
  FOLLOW
  MESSAGE
}
