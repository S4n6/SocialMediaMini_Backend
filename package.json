    "@types/ioredis": "^4.28.10",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/uuid": "^11.0.0",
    "amqplib": "^0.10.9",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.58.5",
    "cache-manager": "^7.2.0",
    "cacheable": "^1.10.4",
