import { Injectable, Logger } from '@nestjs/common';
import { MainWebSocketGateway } from '../../../../infrastructure/websocket';
import {
  NotificationDto,
  NotificationCountDto,
} from '../dto/notification-websocket.dto';
import { WEBSOCKET_ROOMS } from '../../../../infrastructure/websocket/constants';

@Injectable()
export class NotificationWebSocketService {
  private readonly logger = new Logger(NotificationWebSocketService.name);

  constructor(private readonly webSocketGateway: MainWebSocketGateway) {}

  /**
   * Broadcast new notification to user
   */
  async broadcastNewNotification(
    userId: string,
    notification: NotificationDto,
  ): Promise<void> {
    try {
      this.logger.log(
        `Broadcasting new notification ${notification.id} to user ${userId}`,
      );

      // Broadcast to user's general notification room
      await this.webSocketGateway.broadcastToRoom(
        WEBSOCKET_ROOMS.USER_NOTIFICATIONS(userId),
        'notification:new',
        {
          notification,
          timestamp: Date.now(),
        },
      );

      // Also broadcast to type-specific room if user is subscribed
      const typeSpecificRoom = `notifications:${notification.type}:${userId}`;
      await this.webSocketGateway.broadcastToRoom(
        typeSpecificRoom,
        'notification:new',
        {
          notification,
          timestamp: Date.now(),
        },
      );

      this.logger.log(
        `Successfully broadcasted notification ${notification.id} to user ${userId}`,
      );
    } catch (error) {
      this.logger.error(
        `Failed to broadcast notification: ${error.message}`,
        error.stack,
      );
    }
  }

  /**
   * Broadcast notification count update to user
   */
  async broadcastNotificationCount(
    userId: string,
    counts: NotificationCountDto,
  ): Promise<void> {
    try {
      this.logger.log(
        `Broadcasting notification count update to user ${userId}`,
      );

      await this.webSocketGateway.broadcastToRoom(
        WEBSOCKET_ROOMS.USER_NOTIFICATIONS(userId),
        'notification:count_updated',
        {
          counts,
          timestamp: Date.now(),
        },
      );

      this.logger.log(
        `Successfully broadcasted count update to user ${userId}`,
      );
    } catch (error) {
      this.logger.error(
        `Failed to broadcast notification count: ${error.message}`,
        error.stack,
      );
    }
  }

  /**
   * Broadcast notification read status change
   */
  async broadcastNotificationRead(
    userId: string,
    notificationId: string,
  ): Promise<void> {
    try {
      this.logger.log(
        `Broadcasting notification read status for ${notificationId} to user ${userId}`,
      );

      await this.webSocketGateway.broadcastToRoom(
        WEBSOCKET_ROOMS.USER_NOTIFICATIONS(userId),
        'notification:read_status_changed',
        {
          notificationId,
          isRead: true,
          timestamp: Date.now(),
        },
      );
    } catch (error) {
      this.logger.error(
        `Failed to broadcast read status: ${error.message}`,
        error.stack,
      );
    }
  }

  /**
   * Broadcast bulk notification read status change
   */
  async broadcastBulkNotificationRead(
    userId: string,
    markedCount: number,
    type?: string,
  ): Promise<void> {
    try {
      this.logger.log(`Broadcasting bulk read status for user ${userId}`);

      await this.webSocketGateway.broadcastToRoom(
        WEBSOCKET_ROOMS.USER_NOTIFICATIONS(userId),
        'notification:bulk_read_status_changed',
        {
          markedCount,
          type: type || 'all',
          timestamp: Date.now(),
        },
      );
    } catch (error) {
      this.logger.error(
        `Failed to broadcast bulk read status: ${error.message}`,
        error.stack,
      );
    }
  }

  /**
   * Broadcast notification to multiple users
   */
  async broadcastToMultipleUsers(
    userIds: string[],
    notification: NotificationDto,
  ): Promise<void> {
    try {
      this.logger.log(
        `Broadcasting notification ${notification.id} to ${userIds.length} users`,
      );

      const broadcastPromises = userIds.map((userId) =>
        this.broadcastNewNotification(userId, notification),
      );

      await Promise.allSettled(broadcastPromises);

      this.logger.log(`Completed broadcasting to ${userIds.length} users`);
    } catch (error) {
      this.logger.error(
        `Failed to broadcast to multiple users: ${error.message}`,
        error.stack,
      );
    }
  }

  /**
   * Broadcast system-wide notification (to all connected users)
   */
  async broadcastSystemNotification(
    notification: NotificationDto,
  ): Promise<void> {
    try {
      this.logger.log(`Broadcasting system notification ${notification.id}`);

      await this.webSocketGateway.broadcastToAll('notification:system', {
        notification,
        timestamp: Date.now(),
      });

      this.logger.log(`Successfully broadcasted system notification`);
    } catch (error) {
      this.logger.error(
        `Failed to broadcast system notification: ${error.message}`,
        error.stack,
      );
    }
  }

  /**
   * Send real-time typing indicator for notifications (if user is composing)
   */
  async broadcastTypingIndicator(
    userId: string,
    isTyping: boolean,
  ): Promise<void> {
    try {
      await this.webSocketGateway.broadcastToRoom(
        WEBSOCKET_ROOMS.USER_NOTIFICATIONS(userId),
        'notification:typing',
        {
          userId,
          isTyping,
          timestamp: Date.now(),
        },
      );
    } catch (error) {
      this.logger.error(
        `Failed to broadcast typing indicator: ${error.message}`,
        error.stack,
      );
    }
  }

  /**
   * Broadcast notification deletion
   */
  async broadcastNotificationDeleted(
    userId: string,
    notificationId: string,
  ): Promise<void> {
    try {
      this.logger.log(
        `Broadcasting notification deletion ${notificationId} to user ${userId}`,
      );

      await this.webSocketGateway.broadcastToRoom(
        WEBSOCKET_ROOMS.USER_NOTIFICATIONS(userId),
        'notification:deleted',
        {
          notificationId,
          timestamp: Date.now(),
        },
      );
    } catch (error) {
      this.logger.error(
        `Failed to broadcast notification deletion: ${error.message}`,
        error.stack,
      );
    }
  }

  /**
   * Broadcast notification preferences update
   */
  async broadcastPreferencesUpdated(
    userId: string,
    preferences: any,
  ): Promise<void> {
    try {
      this.logger.log(`Broadcasting preferences update to user ${userId}`);

      await this.webSocketGateway.broadcastToRoom(
        WEBSOCKET_ROOMS.USER_NOTIFICATIONS(userId),
        'notification:preferences_updated',
        {
          preferences,
          timestamp: Date.now(),
        },
      );
    } catch (error) {
      this.logger.error(
        `Failed to broadcast preferences update: ${error.message}`,
        error.stack,
      );
    }
  }

  /**
   * Get real-time notification statistics
   */
  async getRealtimeStats(): Promise<{
    connectedUsers: number;
    activeSubscriptions: number;
    notificationsSentToday: number;
  }> {
    try {
      // TODO: Implement actual stats gathering
      // This would typically involve querying the WebSocket gateway and notification service

      return {
        connectedUsers: 0, // await this.webSocketGateway.getStats()?.connections?.uniqueUsers || 0,
        activeSubscriptions: 0, // TODO: Track active subscriptions
        notificationsSentToday: 0, // TODO: Track notifications sent
      };
    } catch (error) {
      this.logger.error(
        `Failed to get realtime stats: ${error.message}`,
        error.stack,
      );
      return {
        connectedUsers: 0,
        activeSubscriptions: 0,
        notificationsSentToday: 0,
      };
    }
  }

  /**
   * Check if user is online and can receive real-time notifications
   */
  async isUserOnline(userId: string): Promise<boolean> {
    try {
      // TODO: Check if user has active WebSocket connections
      // This would involve querying the connection manager
      return false; // Placeholder
    } catch (error) {
      this.logger.error(
        `Failed to check user online status: ${error.message}`,
        error.stack,
      );
      return false;
    }
  }

  /**
   * Send notification only to online users, queue for offline users
   */
  async smartBroadcast(
    userId: string,
    notification: NotificationDto,
  ): Promise<{
    sent: boolean;
    queued: boolean;
  }> {
    try {
      const isOnline = await this.isUserOnline(userId);

      if (isOnline) {
        await this.broadcastNewNotification(userId, notification);
        return { sent: true, queued: false };
      } else {
        // TODO: Queue notification for offline user
        // await this.notificationQueueService.queueForOfflineUser(userId, notification);
        return { sent: false, queued: true };
      }
    } catch (error) {
      this.logger.error(
        `Failed to smart broadcast: ${error.message}`,
        error.stack,
      );
      return { sent: false, queued: false };
    }
  }
}
